{
    "name": "@bspk/icons",
    "version": "1.0.3",
    "main": "index.js",
    "license": "CC-BY-4.0",
    "scripts": {
        "clean": "rm -rf ./*.js ./*.d.ts ./*svg ./src ./meta ./SvgIcon && mkdir -p src && touch ./src/index.ts",
        "build": "ts-node .scripts/build.ts",
        "build:material": "ts-node .scripts/build-material.ts",
        "build:anywhere": "ts-node .scripts/build-anywhere.ts",
        "semantic-release": "semantic-release",
        "pack": "npm run build && npm pack && npm run clean && mkdir -p src && touch ./src/index.ts && tar -xvf *.tgz"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    },
    "peerDependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^11.0.2",
        "@semantic-release/npm": "^12.0.1",
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@types/node": "^22.15.17",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "prettier": "^3.3.3",
        "semantic-release": "^24.2.0",
        "svgo": "^3.3.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    }
}
