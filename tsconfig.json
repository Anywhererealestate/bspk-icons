{
    "compilerOptions": {
        "allowJs": true,
        "target": "ES2015",
        "lib": [
            "es5",
            "dom"
        ],
        "jsx": "react-jsx",
        "moduleResolution": "node",
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "module": "ES2020",
        "declaration": true,
        "outDir": "./dist"
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/index.ts"
    ]
}